# ======================================================================
# FMS trading bot — copy to .env and fill in. NEVER commit your real .env.
# ======================================================================

# --- Telegram phone remote ---------------------------------------------
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the token here.
# 2) Pick a strong password; you'll type "/login <password>" on your phone.
TG_BOT_TOKEN=
TG_PASSWORD=

# --- Broker backend -------------------------------------------------------
#   mt5      generic MetaTrader 5 (Windows only)
#   exness   MT5 + Exness traits ('m' symbol suffix, IOC filling)
#   deriv    MT5 + Deriv traits (FOK filling, 24/7 synthetics AND crypto)
#   vantage  MT5 + Vantage traits ('+' symbol suffix)
#   oanda    OANDA REST API (any OS; forex + metals)
#   binance  Binance USD-M Futures REST API (any OS; crypto, 24/7)
BROKER=mt5

# --- Binance USD-M Futures (BROKER=binance) -------------------------------
# START ON TESTNET: https://testnet.binancefuture.com (free, play money,
# identical API). Create a key with Futures trading ON and withdrawals OFF.
# Symbols are Binance-style: BTCUSDT, ETHUSDT.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=1

# --- Signal copier (optional) ---------------------------------------------
# Reads signals from a Telegram GROUP you belong to (signal_copier.py).
# Needs a Telegram *user* API key from https://my.telegram.org -> API
# development tools. Find the group id with:  python signal_copier.py --list-chats
# Runs in PAPER mode unless you pass --live; measure the group for weeks first.
TG_API_ID=
TG_API_HASH=
SIGNAL_CHAT_ID=

# --- Broker profiles (optional) -------------------------------------------
# Keep several MT5 accounts configured side by side and switch with:
#   python profile.py list | add <name> | use <name> | brokers
# Each profile has its own symbols because naming differs per broker
# (Exness: EURUSDm / most others: EURUSD). Leave ACTIVE_BROKER empty to use
# the plain MT5_* settings below.
ACTIVE_BROKER=
# BROKER_EXNESS_LOGIN=
# BROKER_EXNESS_PASSWORD=
# BROKER_EXNESS_SERVER=ExnessKE-MT5Trial9
# BROKER_EXNESS_SYMBOLS=EURUSDm,XAUUSDm,BTCUSDm
# BROKER_HFM_LOGIN=
# BROKER_HFM_PASSWORD=
# BROKER_HFM_SERVER=
# BROKER_HFM_SYMBOLS=EURUSD,XAUUSD,BTCUSD

# --- MetaTrader 5 account (BROKER=mt5; use a DEMO account first!) --------
# Used when ACTIVE_BROKER is empty, or as a fallback for missing profile keys.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 isn't found automatically
MT5_PATH=

# --- OANDA account (BROKER=oanda; use a practice account first!) ---------
# Portal -> Manage API Access -> generate token; account id looks like 101-001-1234567-001
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# --- Trading -------------------------------------------------------------
# Forex: EURUSD, GBPUSD... | Metals: XAUUSD (gold), XAGUSD (silver)
# Crypto: BTCUSD, ETHUSD — these trade 24/7, including weekends when forex
#         is closed. Spreads are much wider, so expect fewer profitable
#         signals per trade than on forex.
# Stocks/CFDs: AAPL, TSLA... (exchange hours only)
# Exact names depend on your broker — Exness adds an 'm' suffix
# (EURUSDm, XAUUSDm, BTCUSDm). Check Market Watch in MT5 (Ctrl+U).
SYMBOLS=EURUSD,XAUUSD
TIMEFRAME=M5

# --- Entry mode ------------------------------------------------------------
# signal   = trade only EMA-crossover signals (default; a few trades a day)
# interval = attempt a trade every ENTRY_INTERVAL_SECONDS in the trend
#            direction. MUCH more trading, and you pay the spread on every
#            trade — it loses money steadily by construction. DEMO ONLY.
#            To actually reach the full rate you must also relax the gates:
#            COOLDOWN_SECONDS<=interval, MAX_TRADES_PER_DAY and
#            MAX_OPEN_POSITIONS raised, and use TIMEFRAME=M1.
ENTRY_MODE=signal
ENTRY_INTERVAL_SECONDS=30

# --- Strategy --------------------------------------------------------------
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_FLOOR=45
RSI_CEILING=55
ATR_PERIOD=14
ATR_SL_MULT=1.5
ATR_TP_MULT=2.0

# --- Risk ---------------------------------------------------------------------
# Fixed lot size per trade. When > 0 this OVERRIDES RISK_PCT — every trade
# uses exactly this many lots. 0.01 is the broker minimum on most accounts
# and the safest way to cap exposure while testing. Set 0 to size by risk.
FIXED_LOT=0
RISK_PCT=0.5                # % of balance risked per trade (used when FIXED_LOT=0)
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MAX_TRADES_PER_DAY=10
DAILY_LOSS_LIMIT_PCT=3      # stop trading for the day at -3%
COOLDOWN_SECONDS=300
START_PAUSED=1              # bot waits for /resume from your phone

LOG_LEVEL=INFO
