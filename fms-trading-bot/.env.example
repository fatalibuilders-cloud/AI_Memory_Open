# ======================================================================
# FMS trading bot — copy to .env and fill in. NEVER commit your real .env.
# ======================================================================

# --- Telegram phone remote ---------------------------------------------
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the token here.
# 2) Pick a strong password; you'll type "/login <password>" on your phone.
TG_BOT_TOKEN=
TG_PASSWORD=

# --- Broker: "mt5" (Windows only; forex+metals+stocks) or
#             "oanda" (any OS; forex+metals only) -------------------------
BROKER=mt5

# --- MetaTrader 5 account (BROKER=mt5; use a DEMO account first!) --------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 isn't found automatically
MT5_PATH=

# --- OANDA account (BROKER=oanda; use a practice account first!) ---------
# Portal -> Manage API Access -> generate token; account id looks like 101-001-1234567-001
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# --- Trading -------------------------------------------------------------
# Forex: EURUSD, GBPUSD... | Metals: XAUUSD (gold), XAGUSD (silver)
# Stocks/CFDs: AAPL, TSLA... (exact names depend on your broker)
SYMBOLS=EURUSD,XAUUSD
TIMEFRAME=M5

# --- Entry mode ------------------------------------------------------------
# signal   = trade only EMA-crossover signals (default; a few trades a day)
# interval = attempt a trade every ENTRY_INTERVAL_SECONDS in the trend
#            direction. MUCH more trading, and you pay the spread on every
#            trade — it loses money steadily by construction. DEMO ONLY.
#            To actually reach the full rate you must also relax the gates:
#            COOLDOWN_SECONDS<=interval, MAX_TRADES_PER_DAY and
#            MAX_OPEN_POSITIONS raised, and use TIMEFRAME=M1.
ENTRY_MODE=signal
ENTRY_INTERVAL_SECONDS=30

# --- Strategy --------------------------------------------------------------
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_FLOOR=45
RSI_CEILING=55
ATR_PERIOD=14
ATR_SL_MULT=1.5
ATR_TP_MULT=2.0

# --- Risk ---------------------------------------------------------------------
# Fixed lot size per trade. When > 0 this OVERRIDES RISK_PCT — every trade
# uses exactly this many lots. 0.01 is the broker minimum on most accounts
# and the safest way to cap exposure while testing. Set 0 to size by risk.
FIXED_LOT=0
RISK_PCT=0.5                # % of balance risked per trade (used when FIXED_LOT=0)
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MAX_TRADES_PER_DAY=10
DAILY_LOSS_LIMIT_PCT=3      # stop trading for the day at -3%
COOLDOWN_SECONDS=300
START_PAUSED=1              # bot waits for /resume from your phone

LOG_LEVEL=INFO
