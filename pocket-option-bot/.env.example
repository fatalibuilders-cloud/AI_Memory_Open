# ======================================================================
# Pocket Option bot configuration — copy to .env and fill in.
# NEVER commit your real .env (it contains your session credential).
# ======================================================================

# --- Connection --------------------------------------------------------
# Full auth frame captured from browser devtools (see README, step 2).
# It looks like: 42["auth",{"session":"abc123...","isDemo":1,"uid":12345678,"platform":2}]
PO_SSID=

# 1 = demo account (default, START HERE), 0 = live/real account
PO_DEMO=1

# --- Trading -----------------------------------------------------------
PO_ASSET=EURUSD_otc
PO_EXPIRY_SECONDS=60
PO_CANDLE_SECONDS=60

# --- Money management ----------------------------------------------------
PO_STAKE=1
PO_STAKE_PCT=0            # if >0, stake = balance * pct% (overrides PO_STAKE)
PO_MAX_STAKE=50
PO_MAX_TRADES_PER_DAY=20
PO_MAX_CONSECUTIVE_LOSSES=3
PO_DAILY_LOSS_LIMIT=20
PO_DAILY_PROFIT_TARGET=0  # 0 = disabled
PO_COOLDOWN_SECONDS=120

# --- Strategy ------------------------------------------------------------
PO_STRATEGY=rsi_ema       # rsi_ema | bollinger
PO_RSI_PERIOD=14
PO_RSI_OVERSOLD=30
PO_RSI_OVERBOUGHT=70
PO_EMA_PERIOD=50
PO_MIN_CANDLES=60

# --- Misc ----------------------------------------------------------------
PO_LOG_LEVEL=INFO
PO_DRY_RUN=0
