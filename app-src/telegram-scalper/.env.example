# Copy to .env and fill in. NEVER commit .env.
#
# --- Telegram (get these from https://my.telegram.org -> API development tools) ---
# These identify the *app*, not your account. You log in with your phone number once
# and Telethon stores an encrypted session file, so no password is kept here.
TG_API_ID=
TG_API_HASH=
TG_PHONE=+254700000000

# Optional: 2FA cloud password, only if your account has one set.
# Leave blank to be prompted interactively at first login instead (safer).
TG_2FA_PASSWORD=

# --- Control bot (optional) ---
# A @BotFather bot you chat with to run the copier: /status, /selectgroup,
# /pause. This is the control panel ONLY — it cannot read your signal groups,
# because no bot can read a chat it has not been added to. The account login
# above still does the listening.
#
# Token: @BotFather -> /mybots -> your bot -> API Token
TG_BOT_TOKEN=

# Your own Telegram user id. The bot obeys ONLY this id — without it, anyone
# who finds the bot could control your trading, so it refuses to start.
# Find it by messaging @userinfobot, or send /start to your own bot once and
# read the id back from its reply.
TG_OWNER_ID=

# --- Broker: MetaTrader 5 ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Absolute path to terminal64.exe. Leave blank to attach to an already-running terminal.
MT5_TERMINAL_PATH=

# --- Live trading kill switch ---
# The bot refuses to place real orders unless BOTH of these are true:
#   config.yaml -> execution.mode: live
#   TGSCALPER_ALLOW_LIVE=I_UNDERSTAND_THE_RISK
# Anything else falls back to the paper broker.
TGSCALPER_ALLOW_LIVE=
