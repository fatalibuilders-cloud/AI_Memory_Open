# Copy to .env and fill in. NEVER commit the filled-in .env — it holds a token
# that can trade your account.

# ============================================================
# REQUIRED
# ============================================================

# Register an app at https://developers.deriv.com to get an app_id.
# 1089 is Deriv's public testing app_id and is fine to start with.
DERIV_APP_ID=1089

# Create at: Deriv account > Settings > API token.
# Scopes needed: read + trade.  Do NOT grant "payments" or "admin".
# Start with a token for your VIRTUAL (demo) account.
DERIV_API_TOKEN=

# ============================================================
# SAFETY — read this section before changing anything in it
# ============================================================

# The bot refuses to trade a real-money account unless this is true.
# Leave it false until you have watched the bot run on demo for a while.
DERIV_ALLOW_REAL_MONEY=false

# Evaluate signals and price contracts, but never actually buy.
# The best way to watch what the bot would do before letting it do it.
DERIV_DRY_RUN=false

# Create this file to stop all trading immediately; delete it to resume.
# The bot checks every cycle, so `touch KILL_SWITCH` halts it within seconds.
KILL_SWITCH_FILE=KILL_SWITCH

# ============================================================
# UNIVERSE — cryptocurrency only, always
# ============================================================

# Blank means "every open crypto symbol Deriv offers". Symbols listed here are
# still checked against Deriv's market field, so a non-crypto symbol is dropped
# rather than traded.
# Example: DERIV_SYMBOLS=cryBTCUSD,cryETHUSD
DERIV_SYMBOLS=

# Cap on how many symbols to watch per cycle (0 = no cap).
MAX_SYMBOLS=6

# ============================================================
# STRATEGY
# ============================================================

CANDLE_GRANULARITY=60      # seconds per candle
CANDLE_COUNT=200           # candles fetched per evaluation
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_UPPER=70               # bullish crossovers above this RSI are skipped
RSI_LOWER=30               # bearish crossovers below this RSI are skipped
ATR_PERIOD=14
MIN_SEPARATION_ATR=0.15    # EMAs must be this many ATRs apart to count

# ============================================================
# TRADE SIZING
# ============================================================

STAKE=1.0
CURRENCY=                  # blank = use the account currency
TRADE_DURATION=5
TRADE_DURATION_UNIT=m      # t=ticks, s, m, h, d

# ============================================================
# RISK LIMITS
# ============================================================

MAX_OPEN_TRADES=2          # concurrent positions
MAX_TRADES_PER_DAY=40
DAILY_LOSS_LIMIT=20.0      # halt for the rest of the UTC day at this loss
DAILY_PROFIT_TARGET=0      # 0 disables; otherwise halt once reached
MAX_STAKE_FRACTION=0.02    # never stake more than 2% of balance
SYMBOL_COOLDOWN=300        # seconds before re-trading the same symbol

# ============================================================
# OPERATIONS
# ============================================================

POLL_INTERVAL=30           # seconds between trading cycles
RECONNECT_MAX_DELAY=120    # backoff ceiling after a dropped connection
REQUEST_TIMEOUT=30
STATE_FILE=state/bot-state.json
JOURNAL_FILE=state/trades.jsonl
LOG_LEVEL=INFO             # DEBUG shows why each symbol was skipped
