# Copy to .env.local for local overrides. NEVER commit real values.

# --- Core -------------------------------------------------------------------

# Managed PostgreSQL connection string. When unset, the app uses an embedded
# local database (.pglite/) — fine for development.
DATABASE_URL=

# Public URL of the deployed app, used for payment redirects and the links in
# receipt emails. Must be the real domain in production.
APP_URL=http://localhost:3000

# Set to 1 to skip loading the sample masjid projects (use with real data).
SKIP_SEED=

# --- Payments ---------------------------------------------------------------

# When STRIPE_SECRET_KEY is unset the app uses the built-in payment simulator:
# the full donation flow works, but no money moves.
STRIPE_SECRET_KEY=
# Signing secret for the /api/payments/webhook endpoint (Stripe dashboard → webhooks).
STRIPE_WEBHOOK_SECRET=

# M-Pesa (Safaricom Daraja). Unset means the built-in simulator handles the
# M-Pesa rail: the whole flow works, including the callback, but no money moves.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# "paybill" (default) or "till", matching the number the trust holds.
MPESA_SHORTCODE_TYPE=paybill
# "sandbox" (default) or "production".
MPESA_ENV=sandbox

# USD to KES, set by hand and reviewed periodically. Deliberately not a live
# feed: a rate that moves mid-donation makes receipts disagree with the ledger,
# and a rate-service outage would stop donations. Defaults to 129.
USD_KES_RATE=

# --- Email ------------------------------------------------------------------

# When RESEND_API_KEY is unset, receipts are logged rather than sent — they
# still appear in the admin email log, but donors receive nothing.
RESEND_API_KEY=
EMAIL_FROM="Masjid Fund <receipts@yourdomain.org>"
EMAIL_REPLY_TO=

# --- Organisation (printed on receipts) -------------------------------------

ORG_NAME="Masjid Fund"
# Registration number. While empty, receipts state plainly that the body has no
# registration configured — they never imply a charity status you do not hold.
ORG_REGISTRATION=
ORG_REGISTRAR="NGOs Co-ordination Board, Kenya"
ORG_ADDRESS=
ORG_EMAIL=

# Salt for the one-way IP hashes used to throttle donations and applications.
# Set any long random string; changing it resets the counters.
IP_HASH_SALT=

# --- Admin ------------------------------------------------------------------

# Staff sign-in for /admin. Generate the hash with:
#   npm run admin:hash -- 'the password'
# With these unset, development builds accept admin@localhost / masjidfund-dev,
# and production refuses admin sign-in entirely.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
