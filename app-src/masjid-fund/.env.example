# Copy to .env.local for local overrides. NEVER commit real values.

# Managed PostgreSQL connection string. When unset, the app uses an embedded
# local database (.pglite/) — fine for development.
DATABASE_URL=

# Public URL of the deployed app, used for payment redirects.
APP_URL=http://localhost:3000

# Stripe. When STRIPE_SECRET_KEY is unset the app uses the built-in payment
# simulator: the full donation flow works, but no money moves.
STRIPE_SECRET_KEY=
# Signing secret for the /api/payments/webhook endpoint (Stripe dashboard → webhooks).
STRIPE_WEBHOOK_SECRET=

# Set to 1 to skip loading the sample masjid projects (use with real data).
SKIP_SEED=
