<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AssemblyName>TeleScalper</AssemblyName>
    <RootNamespace>cAlgo.Robots</RootNamespace>
    <Product>TeleScalper</Product>
    <Company>Fatali Builders</Company>
    <Version>1.0.0</Version>
    <!-- Ship the source inside the .algo so the bot can be inspected/edited in cTrader Automate -->
    <IncludeSource>True</IncludeSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.19" />
  </ItemGroup>

</Project>
