<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dusk, everywhere. The page itself is dark by design, so the window it
      sits in must be too — otherwise a light system theme shows a white
      frame for the split second before the first paint.
    -->
    <style name="Theme.NairobiWild" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
